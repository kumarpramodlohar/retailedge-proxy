#!/bin/bash
set -e

if ! id -u retailedge > /dev/null 2>&1; then
    useradd --system --no-create-home --shell /usr/sbin/nologin retailedge
    echo "Created system user: retailedge"
fi

systemctl daemon-reload
systemctl enable retailedge-events
systemctl start retailedge-events

echo "retailedge-events installed and started"